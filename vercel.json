{
    "installCommand": "pip install -r requirements.txt && npm install --workspaces --include-workspace-root",
    "buildCommand": "npm run build --workspace=web && mkdir -p dist && cp -r apps/web/dist/* dist/",
    "outputDirectory": "dist",
    "functions": {
        "apps/api/index.py": {
            "runtime": "vercel-python@4.3.1",
            "maxDuration": 30
        }
    },
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/apps/api/index.py" },
        { "source": "/((?!api/).*)", "destination": "/index.html" }
    ]
}